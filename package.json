{
  "name": "care-id",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "start:local": "docker compose up -d --wait db && prisma migrate deploy && npm run db:seed && next dev",
    "stop:local": "pkill -f \"$PWD/node_modules/.bin/next dev\"; docker compose stop db",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate && cp node_modules/maplibre-gl/dist/maplibre-gl-worker.mjs public/maplibre-gl-worker.mjs",
    "db:up": "docker compose up -d db",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "node --env-file=.env --conditions=react-server --import tsx scripts/seed.ts",
    "db:reset": "prisma migrate reset --force && npm run db:seed",
    "user:add": "node --env-file=.env --conditions=react-server --import tsx scripts/add-user.ts",
    "data:synthetic": "tsx scripts/gen-synthetic.ts",
    "geo:build": "tsx scripts/build-fsa-geo.ts",
    "schools:import": "tsx scripts/import-schools.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@turf/boolean-point-in-polygon": "^7.4.0",
    "dotenv": "^18.0.9",
    "maplibre-gl": "^6.16.0",
    "next": "^16.4.3",
    "papaparse": "^5.7.0",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-map-gl": "^8.1.3",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^22.20.5",
    "@types/papaparse": "^5.5.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.4.3",
    "mapshaper": "^0.7.101",
    "prisma": "^7.10.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
